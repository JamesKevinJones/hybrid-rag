# Copy to .env. Nothing here is required - every value has a default in config.py.
# Nesting uses a double underscore: HYBRID_RAG_<SECTION>__<FIELD>.

# --- Level 0 (local) ---------------------------------------------------------
HYBRID_RAG_OLLAMA__BASE_URL=http://localhost:11434
HYBRID_RAG_OLLAMA__ROUTER_MODEL=qwen2.5:1.5b-instruct-q4_K_M
HYBRID_RAG_OLLAMA__GENERATOR_MODEL=llama3.2:3b-instruct-q4_K_M
HYBRID_RAG_OLLAMA__EMBED_MODEL=nomic-embed-text:v1.5
HYBRID_RAG_OLLAMA__SEED=1337

# --- Routing -----------------------------------------------------------------
HYBRID_RAG_ROUTING__ESCALATION_THRESHOLD=0.78
HYBRID_RAG_ROUTING__SLM_VOTE_ENABLED=true
# Kill switch: pin everything to Level 0 regardless of signals.
HYBRID_RAG_ROUTING__FORCE_LOCAL=false

# --- Claude Pro budget -------------------------------------------------------
# These are YOUR account's numbers, not constants. Set them from what the
# account actually shows; the gate enforces whatever you declare here.
HYBRID_RAG_BUDGET__WINDOW_HOURS=5
HYBRID_RAG_BUDGET__MAX_MESSAGES_PER_WINDOW=45
HYBRID_RAG_BUDGET__MAX_TOKENS_PER_WINDOW=900000
HYBRID_RAG_BUDGET__RESERVE_FRACTION=0.20

# --- Level 2 (cloud) ---------------------------------------------------------
HYBRID_RAG_ANTHROPIC__MODEL=claude-opus-5
# Leave unset to use the ambient ANTHROPIC_API_KEY. Never commit a real key.
# HYBRID_RAG_ANTHROPIC__API_KEY=
