// VS Code MCP server definition. This file is JSONC - VS Code parses comments.
//
// `command` is the workspace virtual environment's interpreter, by absolute
// path, rather than `uv` or a bare `python`. Three failure modes go away with
// it: `uv` not being on the PATH VS Code inherited (which differs from the one
// a terminal gets), the system interpreter here being 3.14 while this project
// pins <3.13, and `uv run` resolving against whatever directory the extension
// happened to launch from.
//
// The module path is `hybrid_rag.mcp_servers.server`, NOT
// `src.hybrid_rag.mcp_servers.server`. The latter appears to work from the repo
// root - `src/` has no `__init__.py`, so it resolves as an implicit namespace
// package while the current directory is on `sys.path` - and then fails with
// `No module named 'src'` the moment the working directory is anything else.
// Worse, when it does resolve it imports this package twice under two names,
// because the server's own imports (`from hybrid_rag.config import ...`) load
// the installed copy alongside it. `hybrid_rag.` uses the installed
// distribution and does not depend on the working directory at all.
//
// Windows paths. On a POSIX host this is `.venv/bin/python`.
//
// Verify with: uv run python scripts/verify_mcp_clients.py
{
  "servers": {
    "hybrid-rag": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "hybrid_rag.mcp_servers.server"],
      "cwd": "${workspaceFolder}"
    }
  }
}
